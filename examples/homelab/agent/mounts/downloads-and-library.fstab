# Hermes VM only. Credentials are provisioned privately, root:root mode 0600.
//media-host.example/agent-downloads /mnt/agent/downloads cifs credentials=/etc/samba/credentials-agent-media,vers=3.1.1,seal,uid=1000,gid=1000,forceuid,forcegid,file_mode=0660,dir_mode=0770,nosuid,nodev,noexec,_netdev,nofail,x-systemd.automount,x-systemd.idle-timeout=10min,x-systemd.mount-timeout=20s 0 0
//media-host.example/agent-library /mnt/agent/library cifs credentials=/etc/samba/credentials-agent-media,vers=3.1.1,seal,uid=1000,gid=1000,forceuid,forcegid,file_mode=0660,dir_mode=0770,nosuid,nodev,noexec,_netdev,nofail,x-systemd.automount,x-systemd.idle-timeout=10min,x-systemd.mount-timeout=20s 0 0

[Unit]
Description=Hermes VPN torrent stack
Requires=docker.service
After=docker.service network-online.target zfs-mount.service
Wants=network-online.target
RequiresMountsFor=/srv/media/downloads/agent /srv/appdata/agent-media

[Service]
Type=simple
User=mediaops
WorkingDirectory=/opt/agent-media
ExecStartPre=/usr/bin/python3 /opt/agent-media/admin.py preflight
ExecStart=/usr/bin/docker compose up --abort-on-container-exit
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=15
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
